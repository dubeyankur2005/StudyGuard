{
  "manifest_version": 3,
  "name": "StudyGuard",
  "short_name": "StudyGuard",
  "description": "Track YouTube study time, block distractions, and improve productivity.",
  "version": "1.0.0",



  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "notifications",
    "alarms",
    "scripting"
  ],

  "host_permissions": [
    "https://www.youtube.com/*",
    "http://localhost:3000/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_title": "StudyGuard",
    "default_popup": "popup/popup.html"
  },

  "options_page": "options/options.html",

  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": [
        "assets/*"
      ],
      "matches": [
        "https://www.youtube.com/*"
      ]
    }
  ]
}